# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# If you suspect any value has leaked, rotate it on the provider's dashboard
# (do not just edit it here).

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5001

# ── MongoDB (Atlas) ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# Rotate the user password from MongoDB Atlas → Database Access if compromised.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
# Rotate at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_api_key

# ── Email (Gmail SMTP, for password reset OTPs) ────────────────────────────────
# EMAIL_PASS must be a Gmail **App Password**, not the account password.
# Generate / rotate at https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Groq (LLaMA / Whisper inference) ───────────────────────────────────────────
# Rotate at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# ── Google OAuth (Sign in with Google) ─────────────────────────────────────────
# Rotate at https://console.cloud.google.com/apis/credentials
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
